# Copy to .env and fill in values you need. Every value has a default in
# devlens/config/settings.py, so you only need to set what you want to change.

# GitHub API (optional). Without a token, GitHub allows 60 unauthenticated
# requests/hour, which a single repo analysis can burn through quickly.
# Create one at https://github.com/settings/tokens — no scopes needed for
# public data ("no scopes selected" is enough to raise the limit to 5000/hour).
# GITHUB_TOKEN=
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_CACHE_TTL_SECONDS=3600

# Gemini API (optional). Without a key, AI commentary falls back to a
# placeholder message instead of failing the whole report. Get a key at
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-flash-latest
# AI commentary is cached per (username, career_goal) combo for this many
# seconds, so re-analyzing the same pair within the window costs no Gemini call.
# GEMINI_CACHE_TTL_SECONDS=3600

# Radar score history (SQLite, no setup needed — the file/folder are created
# automatically on first run). Keyed by GitHub username only (no login system).
# SNAPSHOT_DB_PATH=./data/snapshots.db

# Comma-separated origins allowed to call the API (CORS), e.g. the frontend
# SPA's dev server or deployed URL.
# CORS_ORIGINS=http://localhost:5173
